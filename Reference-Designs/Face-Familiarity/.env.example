# Required. Get one from https://dashboard.eyepop.ai (compute API key, starts with eyp_).
EYEPOP_API_KEY=

# Optional. Defaults to EyePop's production compute API.
EYEPOP_URL=https://compute.eyepop.ai

# Optional. Seconds between sampled frames during ingest/score — lower for
# short clips (e.g. 0.25-0.5), higher for long ones to save on EyePop calls.
SAMPLE_INTERVAL_SECONDS=2

# Optional. Cosine-similarity cutoff for "this is a known person" vs.
# "Unknown" — see CALIBRATION.md before changing this.
FAMILIARITY_THRESHOLD=0.45

# Optional. Local port for server.py.
PORT=8080
